  "decisions": [
    {
      "id": "DEC-action-no-suppression",
      "summary": "An existing compliance calendar action is cross referenced and never suppresses a proposed action.",
      "evidence_ids": [
        "SRC-CALENDAR"
      ],
      "rationale": "Judging their existing action sufficient would be an Operations decision. Cross referencing shows the overlap and leaves the call with them.",
      "tradeoffs": [
        "Some proposed actions will look like duplicates of calendar rows.",
        "The register row names the existing action so the overlap is visible."
      ]
    }
  ]
